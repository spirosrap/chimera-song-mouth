end":46.35,"text":"Mountain Mama."},{"time":47.65,"end":59.05,"text":"Take me home, Country Roads, All my memories gather round"},{"time":59.05,"end":62.91,"text":"her, Miner's lady,"},{"time":63.51,"end":70.03,"text":"stranger to blue water Dark and dusty,"},{"time":70.85000000000001,"end":77.45,"text":"painted on the sky, misty taste of moonshine, teardrop in"},{"time":77.45,"end":78.37,"text":"my eye."},{"time":78.79,"end":89.77000000000001,"text":"Country Roads, take me home to the place I belong,"},{"time":90.43,"end":94.57000000000001,"text":"West Virginia Mountain Mama."},{"time":95.65,"end":102.03,"text":"Take me home, Country Roads."},{"time":103.05000000000001,"end":106.89,"text":"I hear her voice in the morning hour as she"},{"time":106.89,"end":112.47,"text":"calls me. The radio reminds me of my home far"},{"time":112.47,"end":118.01,"text":"away. Driving down the road I get a feeling that"},{"time":118.01,"end":124.67,"text":"I should have been home yesterday yesterday"},{"time":125.35000000000001,"end":136.39000000000001,"text":"Country Roads, take me home to the place I belong."},{"time":136.55,"end":148.99,"text":"West Virginia Mountain Mama take me home Country Roads Country"},{"time":148.99,"end":160.61,"text":"Roads, Take me home to the place I belong, West"},{"time":160.61,"end":171.63,"text":"Virginia Mountain Mama take me home Country Roads"},{"time":172.25,"end":177.51000000000002,"text":"me home. Country Roads,"},{"time":177.93,"end":180.31,"text":"take me home."},{"time":180.93,"end":183.61,"text":"Country Roads."}],"sections":[{"name":"Intro","time":0},{"name":"Verse 1","time":6.45},{"name":"Chorus 1","time":30.689999999999998},{"name":"Verse 2","time":54.85},{"name":"Chorus 2","time":78.79},{"name":"Bridge","time":103.05000000000001},{"name":"Chorus 3","time":125.35000000000001},{"name":"Final chorus","time":148.43},{"name":"Outro","time":172.21},{"name":"Instrumental ending","time":184.05}]}