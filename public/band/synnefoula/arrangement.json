ntro","time":0},{"name":"Whistling","time":4.14},{"name":"First verse","time":22.49},{"name":"Whistling","time":53.81},{"name":"Second verse","time":64.49},{"name":"Whistling","time":96.16},{"name":"Final verse","time":107.75},{"name":"Instrumental ending","time":125.5}],"captions":[{"time":4.14306,"end":19.67721,"text":"Whistling · σφύριγμα"},{"time":22.529999999999998,"end":25.709999999999997,"text":"Είχα μια αγάπη, αχ, καρδούλα μου,"},{"time":26.57,"end":29.43,"text":"που μοιάζε συννεφάκι συννεφούλα μου."},{"time":29.65,"end":34.129999999999995,"text":"Σαν συννεφά, συννεφάκι φεύγει, ξανά γυρνάει"},{"time":34.129999999999995,"end":38.15,"text":"Μ' αγαπάει την μια, την άλλη με ξεχνάει"},{"time":38.15,"end":42.05,"text":"Κ' ένα βράδυ, κ' ένα βράδυ βράδυ, αχ, καρδούλα μου"},{"time":42.05,"end":45.71,"text":"Διώχνω ξαφνικά τη συννεφούλα μου"},{"time":45.71,"end":49.99,"text":"Δεν αντέχω, δεν αντέχω, άλλο πια να με γελάει"},{"time":49.99,"end":53.61,"text":"Μ' αγαπάει την μια, την άλλη με ξεχνάει"},{"time":53.81054,"end":61.194489999999995,"text":"Whistling · σφύριγμα"},{"time":64.49000000000001,"end":72.63000000000001,"text":"Κι έρχεται ο Απρίλης, αχ καρδούλα μου, να κι ο Μάης ο Μάης συννεφούλα μου,"},{"time":73.21000000000001,"end":79.75,"text":"δίχως δίχως τραγούδι, δάκρυ και φιλί, δεν είναι, δεν είναι άνοιξη φέτος αυτή."},{"time":80.63000000000001,"end":87.59,"text":"Συννεφούλα, συννεφούλα, να γυρίσεις σου ζητώ και τριγύρνα μου όσους θέλεις κάθε βράδυ."},{"time":88.66999999999999,"end":95.59,"text":"Δεν αντέχω, δεν αντέχω, άλλο να είμαι μοναχός, μ' αγαπάς τη μια κι ας με ξεχνάς την άλλη."},{"time":96.16374,"end":103.89599,"text":"Whistling · σφύριγμα"},{"time":107.75,"end":116.51,"text":"Είχα, είχα μια αγάπη, αχ, καρδούλα μου, που μοιάζε συννεφάκι, συννεφούλα μου."},{"time":117.83000000000001,"end":125.49000000000001,"text":"Σαν συννεφά, συννεφάκι, φεύγει ξανά γυρνάει, με αγαπάει την μια, την άλλη με ξεχνάει."}]}