{"setting":"cliffs","title":"The Princess Bride · Inconceivable!","description":"The complete supplied Cliffs of Insanity scene, with three physical voices, a rope climb, the masked pursuer and subtitles.","duration":140.5,"audio":"mix.mp3","characters":[{"id":"vizzini","name":"Vizzini","role":"The impatient mastermind · a sharp, higher voice","tele":"vizzini.tele","telemetryEncoding":"gzip"},{"id":"inigo","name":"Inigo Montoya","role":"The swordsman · a measured middle voice","tele":"inigo.tele","telemetryEncoding":"gzip"},{"id":"fezzik","name":"Fezzik","role":"The giant · a slow, low voice","tele":"fezzik.tele","telemetryEncoding":"gzip"}],"cues":[{"start":25.65,"end":27.2,"speaker":"inigo","text":"He's climbing the rope!","intensity":0.6},{"start":28.4,"end":29.65,"speaker":"inigo","text":"And he's gaining on us.","intensity":0.6},{"start":31.1,"end":32.27,"speaker":"vizzini","text":"Inconceivable!","intensity":0.85},{"start":34.44,"end":35.14,"speaker":"vizzini","text":"Faster!","intensity":0.85},{"start":35.47,"end":37.27,"speaker":"fezzik","text":"I thought I was going faster.","intensity":0.35},{"start":37.63,"end":39.65,"speaker":"vizzini","text":"You were supposed to be this colossus.","intensity":0.85},{"start":39.91,"end":41.71,"speaker":"vizzini","text":"You were this great legendary thing.","intensity":0.85},{"start":41.95,"end":42.97,"speaker":"vizzini","text":"And yet he gains.","intensity":0.85},{"start":43.43,"end":45.51,"speaker":"fezzik","text":"Well, I'm carrying three people.","intensity":0.35},{"start":46.01,"end":47.03,"speaker":"fezzik","text":"And he's got only himself.","intensity":0.35},{"start":47.13,"end":48.31,"speaker":"vizzini","text":"I do not accept excuses.","intensity":0.85},{"start":48.47,"end":50.75,"speaker":"vizzini","text":"I'm just going to have to find myself a new giant, that's all.","intensity":0.85},{"start":50.97,"end":52.35,"speaker":"fezzik","text":"Don't say that, Vizzini.","intensity":0.35},{"start":52.73,"end":53.17,"speaker":"fezzik","text":"Please!","intensity":0.35},{"start":58.67,"end":62.45,"speaker":"vizzini","text":"Did I make it clear that your job is at stake?","intensity":0.85},{"start":123.65,"end":125.27,"speaker":"fezzik","text":"He's got very good arms.","intensity":0.35},{"start":127.81,"end":128.71,"speaker":"vizzini","text":"He didn't fall?","intensity":0.85},{"start":129.3,"end":130.59,"speaker":"vizzini","text":"Inconceivable!","intensity":0.85},{"start":131.43,"end":132.59,"speaker":"inigo","text":"You keep using that word.","intensity":0.48},{"start":133.23,"end":135.09,"speaker":"inigo","text":"I don't think it means what you think it means.","intensity":0.48},{"start":137.59,"end":139.25,"speaker":"inigo","text":"My God, he's climbing.","intensity":0.48}],"shots":[{"time":0,"view":"wide"},{"time":14.35,"view":"climber"},{"time":25.25,"view":"inigo"},{"time":30.65,"view":"vizzini"},{"time":34.25,"view":"vizzini"},{"time":35.25,"view":"fezzik"},{"time":37.55,"view":"vizzini"},{"time":43.25,"view":"fezzik"},{"time":47.05,"view":"vizzini"},{"time":50.85,"view":"fezzik"},{"time":54.35,"view":"climber"},{"time":58.45,"view":"vizzini"},{"time":63.35,"view":"wide"},{"time":67.35,"view":"climber"},{"time":73.35,"view":"wide"},{"time":88.35,"view":"wide"},{"time":95.35,"view":"vizzini"},{"time":102.35,"view":"climber"},{"time":110.35,"view":"wide"},{"time":116.35,"view":"climber"},{"time":123.15,"view":"fezzik"},{"time":127.35,"view":"vizzini"},{"time":131.15,"view":"inigo"},{"time":136.65,"view":"climber"}]}